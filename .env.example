# SERVER ONLY. Set these in Netlify environment variables (Functions scope).
# Never put credentials in dist/, browser JS, public build variables or commits.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer current Supabase server secret key (sb_secret_*).
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
# Legacy fallback supported: SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_JWT
# Generate once with: openssl rand -hex 32
LEADERBOARD_RATE_SALT=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
